@page
@model BankApp.Pages.CountryModel
@{
    ViewData["Title"] = "Top 10 - " + Model.Country;
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>

    <span>›</span>

    <span>@Model.Country</span>

    <span>›</span>

    <span>Top 10 Customers</span>
</div>

<div class="welcome-card">

    <span class="welcome-kicker">
        @Model.Country.ToUpper()
    </span>

    <div class="country-header">

        <img src="@CountryFlags.Wide(Model.Country)"
             class="country-flag-large"
             alt="@Model.Country Flag" />

        <div>

            <h1 class="welcome-title">
                Top 10 Customers in @Model.Country
            </h1>

            <p class="welcome-subtitle">
                Customers with the highest total balance in @Model.Country.
            </p>

        </div>

    </div>

</div>



@if (!Model.TopCustomers.Any())
{
    <p>No customers found for the selected country.</p>
}
else
{
    /* KPI Cards */
    <div class="dashboard-grid">

        <div class="dashboard-card stat-card">
            <div class="stat-icon">
                <i class="mdi mdi-account-group"></i>
            </div>

            <div class="stat-content">
                <div class="stat-title">Top Customers</div>

                <div class="stat-number">
                    @Model.TopCustomers.Count
                </div>

                <div class="stat-subtitle">
                    Highest ranked customers 
                </div>
            </div>
        </div>

        

        <div class="dashboard-card stat-card">
            <div class="stat-icon">
                <i class="mdi mdi-trophy"></i>
            </div>

            <div class="stat-content">
                <div class="stat-title">Average Balance</div>

                <div class="stat-number">
                    @Model.TopCustomers.Average(x => x.TotalBalance).ToString("N0")
                </div>

                <div class="stat-subtitle">
                    Average per customer
                </div>
            </div>
        </div>

        <div class="dashboard-card stat-card">
            <div class="stat-icon">
                <i class="mdi mdi-cash-multiple"></i>
            </div>

            <div class="stat-content">
                <div class="stat-title">Total Balance</div>

                <div class="stat-number">
                    @Model.TopCustomers.Sum(x => x.TotalBalance).ToString("N0")
                </div>

                <div class="stat-subtitle">
                    Combined balance in @Model.Country
                </div>
            </div>
        </div>

    </div>

    /* Tabel */
    <div class="table-card">
        <h3 class="card-title">
            <i class="mdi mdi-trophy-outline icon"></i>
            Ranking
        </h3>
        <div class="table-responsive">
            <table class="mybank-table mobile-cards">
        <thead>
            <tr>
                <th class="rank-column">Rank</th>
                <th>Customer ID</th>
                <th>Name</th>
                <th>City</th>
                <th class="currency">Total Balance</th>
            </tr>
        </thead>
            <tbody>

                @{
                    var rank = 1;
                }

                @foreach (var c in Model.TopCustomers)
                {
                    <tr class="clickable-row">

                    <td class="rank-column" data-label="Rank">
                            @switch (rank)
                            {
                                case 1:
                                    <span>🥇</span>
                                    break;

                                case 2:
                                    <span>🥈</span>
                                    break;

                                case 3:
                                    <span>🥉</span>
                                    break;

                                default:
                                    <span>@rank</span>
                                    break;
                            }
                        </td>

                            <td class="customer-id" data-label="Customer ID">
                                <a asp-page="/Admin/Customer"
                                   asp-route-id="@c.CustomerId"
                                   class="stretched-link">
                                    @c.CustomerId
                                </a>
                            </td>

                            <td class="primary-value" data-label="Name">
                                @c.FullName
                            </td>

                            <td data-label="City">
                                @c.City
                            </td>

                            <td class="currency" data-label="Total Balance">
                                @c.TotalBalance.ToString("N2")
                            </td>

                    </tr>

                    rank++;
                }

            </tbody>
    </table>
    </div>
    </div>

}
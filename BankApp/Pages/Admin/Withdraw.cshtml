@page "{id:int}"
@model BankApp.Pages.Admin.WithdrawModel
@{
    ViewData["Title"] = "Withdraw";
    var currency = CountryCurrency.Code(Model.Account.Country);
    // Shared with the partial _RecentTransactions (partials get the page's ViewData)
    ViewData["Currency"] = currency;
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>
    <span>›</span>
    <a asp-page="/Admin/Customers">Customers</a>
    <span>›</span>
    <a asp-page="/Admin/Customer" asp-route-id="@Model.Account.CustomerId">@Model.Account.CustomerName</a>
    <span>›</span>
    <a asp-page="/Admin/Account" asp-route-id="@Model.Account.AccountId">Account @Model.Account.AccountId</a>
    <span>›</span>
    <span>Withdraw</span>                                                        
</div>

<!-- Page header -->
<partial name="_PageHeader" model='new PageHeaderViewModel
         {
             Kicker = "WITHDRAW",
             Title = "Withdraw",
             Subtitle = $"Withdraw money from account {Model.Account.AccountId}."
         }' />

<div class="customer-profile-layout">

    <!-- Form -->
    <div class="dashboard-card action-card withdraw">
        <h3 class="card-title">
            <i class="mdi mdi-minus-circle-outline icon"></i>
            New Withdrawal                                                       
        </h3>

        <form method="post" data-confirm="withdraw"
              data-from="@Model.Account.AccountId" data-currency="@currency">
            <div class="form-group">
                <label asp-for="Input.Amount">Amount (@currency)</label>
                <input asp-for="Input.Amount" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Input.Amount" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="bank-btn">Confirm withdrawal</button>  
                <a class="bank-btn-outline" asp-page="/Admin/Account" asp-route-id="@Model.Account.AccountId">Cancel</a>
            </div>
        </form>
    </div>

    <!-- Current balance -->
    <div class="dashboard-card balance-card">
        <h3 class="card-title">
            <i class="mdi mdi-wallet-outline icon"></i>
            Current Balance
        </h3>

        <div class="balance-value">
            @($"{Model.Account.Balance:N2} {currency}")
        </div>

        <div class="balance-label">
            @Model.Account.CustomerName · Account @Model.Account.AccountId
        </div>
    </div>

</div>

<!-- Latest 5 transactions (shared partial) -->
<partial name="_RecentTransactions" model="Model.RecentTransactions" />
<partial name="_ConfirmModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
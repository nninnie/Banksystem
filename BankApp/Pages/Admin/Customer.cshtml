@page "{id:int}"
@model BankApp.Pages.Admin.CustomerModel
@{
    ViewData["Title"] = "Customer";
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>

    <span>›</span>

    <a asp-page="/Admin/Customers">
        Customers
    </a>

    <span>›</span>

    <span>@Model.Customer.FullName</span>
</div>

<!-- Page header -->
<div class="welcome-card customer-hero">
    <div class="customer-page-header">


        <div>
            <h2 class="welcome-title">Customer Profile</h2>
            <p class="section-subtitle">View customer details, accounts and balances.</p>
        </div>

        @* Edit customer - enable when EditCustomer (CRUD) is built
@if (User.IsInRole("Cashier"))
{
    <a class="bank-btn customer-edit-btn" asp-page="/Admin/EditCustomer" asp-route-id="@Model.Customer.CustomerId">
        <i class="mdi mdi-pencil-outline"></i>&nbsp;Edit
    </a>
}
*@
    </div>
</div>

<div class="customer-profile-layout">

    <!-- Customer details -->
    <div class="dashboard-card">
        <h3 class="card-title">
    <i class="mdi mdi-account-outline icon"></i>
    Customer Overview
</h3>


        <div class="customer-details-grid">
            <div class="customer-detail">
                <span class="label">Customer Name</span>
                <span class="value customer-name-value">@Model.Customer.FullName</span>
            </div>
            <div class="customer-detail">
                <span class="label">Email Address</span>
                <span class="value">@Model.Customer.Email</span>
            </div>
            <div class="customer-detail">
                <span class="label">Customer ID</span>
                <span class="value">@Model.Customer.CustomerId</span>
            </div>
            <div class="customer-detail">
                <span class="label">Phone Number</span>
                <span class="value">@Model.Customer.Telephone</span>
            </div>
            <div class="customer-detail">
                <span class="label">Personal ID</span>
                <span class="value">@Model.Customer.NationalId</span>
            </div>
            <div class="customer-detail">
                <span class="label">Gender</span>
                <span class="value">@Model.Customer.Gender</span>
            </div>
            <div class="customer-detail">
                <span class="label">Birthday</span>
                <span class="value">@(Model.Customer.Birthday?.ToString("yyyy-MM-dd") ?? "–")</span>
            </div>
            <div class="customer-detail">
                <span class="label">Address</span>
                <span class="value">@Model.Customer.Streetaddress</span>
            </div>
            <div class="customer-detail">
                <span class="label">City</span>
                <span class="value">@Model.Customer.Zipcode @Model.Customer.City</span>
            </div>
            <div class="customer-detail">
                <span class="label">Country</span>
                <span class="value">@Model.Customer.Country</span>
            </div>
        </div>
    </div>


    
    <!-- Total Balance -->
    <div class="dashboard-card balance-card">
        <h3 class="card-title">
            <i class="mdi mdi-currency-usd icon"></i>
            Total Balance
        </h3>

        <div class="balance-value">
            @($"{Model.Customer.TotalBalance:N2} {CountryCurrency.Code(Model.Customer.Country)}")
        </div>

        <div class="balance-label">
            Total balance across all accounts
        </div>

        <!-- Decorative balance line -->
        <div class="balance-sparkline" aria-hidden="true">
            <canvas id="balanceChart"></canvas>
        </div>
    </div>


    <!-- Accounts -->
    <div class="dashboard-card accounts-card">

        <h3 class="card-title">
            <i class="mdi mdi-wallet-outline icon"></i>
            Customer Accounts (@Model.Customer.Accounts.Count)
        </h3>

        <table class="mybank-table">
            <thead>
                <tr>
                    <th>Account Number</th>
                    <th class="currency">Balance</th>
                    <th class="currency">@(User.IsInRole("Cashier") ? "Actions" : "")</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var account in Model.Customer.Accounts)
                {
                    <tr class="clickable-row"
                        onclick="location.href='@Url.Page("/Admin/Account", new { id = account.AccountId })'">

                        <td>
                            <i class="mdi mdi-wallet-outline account-icon"></i>

                            <span class="account-number">
                                Account: @account.AccountId
                            </span>
                        </td>

                        <td class="currency">
                            @($"{account.Balance:N2} {CountryCurrency.Code(Model.Customer.Country)}")
                        </td>

                        <td class="account-action">
                            @if (User.IsInRole("Cashier"))
                            {
                                <!-- Shortcuts: stopPropagation stops the row click so only the button is used -->
                                <div class="account-quick-actions">
                                    <a asp-page="/Admin/Deposit" asp-route-id="@account.AccountId" title="Deposit" onclick="event.stopPropagation()">
                                        <i class="mdi mdi-plus-circle-outline"></i>
                                    </a>
                                    <a asp-page="/Admin/Withdraw" asp-route-id="@account.AccountId" title="Withdraw" onclick="event.stopPropagation()">
                                        <i class="mdi mdi-minus-circle-outline"></i>
                                    </a>
                                    <a asp-page="/Admin/Transfer" asp-route-id="@account.AccountId" title="Transfer" onclick="event.stopPropagation()">
                                        <i class="mdi mdi-swap-horizontal"></i>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <i class="mdi mdi-chevron-right"></i>
                            }
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
@page "{id:int}"
@model BankApp.Pages.Admin.EditCustomerModel
@{
    ViewData["Title"] = "Edit customer";
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>
    <span>›</span>
    <a asp-page="/Admin/Customers">Customers</a>
    <span>›</span>
    <a asp-page="/Admin/Customer" asp-route-id="@Model.Input.CustomerId">@Model.Input.Givenname @Model.Input.Surname</a>
    <span>›</span>
    <span>Edit</span>
</div>

<!-- Page header -->
<partial name="_PageHeader" model='new PageHeaderViewModel
         {
             Kicker = "CUSTOMERS",
             Title = "Edit customer",
             Subtitle = $"Update the details for customer {Model.Input.CustomerId}."
         }' />

<div class="dashboard-card action-card">
    <h3 class="card-title">
        <i class="mdi mdi-account-edit-outline icon"></i>
        Customer details
    </h3>

    <form method="post">
        <partial name="_CustomerForm" for="Input" />

        <div class="form-actions">
            <button type="submit" class="bank-btn">Save changes</button>
            <a class="bank-btn-outline" asp-page="/Admin/Customer" asp-route-id="@Model.Input.CustomerId">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
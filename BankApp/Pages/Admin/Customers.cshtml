@page
@model BankApp.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

@functions {
    private string ActiveColumn =>
        string.IsNullOrEmpty(Model.SortColumn) ? "Id" : Model.SortColumn;

    // Klick på aktiv kolumn (stigande) -> fallande, annars stigande
    private string NextOrder(string column) =>
        ActiveColumn == column && Model.SortOrder != "desc" ? "desc" : "asc";

    private string Arrow(string column) =>
        ActiveColumn != column ? "" : (Model.SortOrder == "desc" ? "▼" : "▲");
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>

    <span>›</span>

    <span>Customers</span>

    <span>›</span>

    <span>Search</span>
</div>

<!-- Page header -->
<div class="welcome-card customer-hero">
    <h2 class="welcome-title">Customer Search</h2>
    <p class="section-subtitle">Search customers by name or city.</p>
</div>


<!-- Search form -->
<div class="dashboard-card search-card">

    <form method="get" class="bank-search">

        <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />

        <div class="row g-3 align-items-start">

            <div class="col-md-3">
                <div class="input-icon">
                    <i class="mdi mdi-account-outline"></i>
                    <input asp-for="SearchName"
                           class="form-control"
                           placeholder="Search by customer ID or name" />
                </div>
                <span asp-validation-for="SearchName" class="text-danger"></span>
            </div>

            <div class="col-md-7">
                <div class="input-icon">
                    <i class="mdi mdi-map-marker-outline"></i>
                    <input asp-for="SearchCity"
                           class="form-control"
                           placeholder="Search by city" />
                </div>
                <span asp-validation-for="SearchCity" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <button type="submit" class="bank-btn w-100">
                    Search
                </button>
            </div>

        </div>
    </form>
</div>


<!-- Customer list -->
<div class="table-card">
    <h3 class="card-title">
        <i class="mdi mdi-account-multiple-outline icon"></i>
        Customers
    </h3>
    <table class="mybank-table">
    <thead>
        <tr>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Id"
                   asp-route-sortOrder="@NextOrder("Id")">ID @Arrow("Id")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="NationalId"
                   asp-route-sortOrder="@NextOrder("NationalId")">National ID @Arrow("NationalId")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Name"
                   asp-route-sortOrder="@NextOrder("Name")">Name @Arrow("Name")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Address"
                   asp-route-sortOrder="@NextOrder("Address")">Address @Arrow("Address")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="City"
                   asp-route-sortOrder="@NextOrder("City")">City @Arrow("City")</a>
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model.Customers)
        {
            <tr class="clickable-row">
                <td class="customer-id">
                    <a asp-page="/Admin/Customer" asp-route-id="@c.CustomerId" class="stretched-link">
                        @c.CustomerId
                    </a>
                </td>
                <td class="national-id" >@c.NationalId</td>
                <td class="primary-value">@c.FullName</td>
                <td>@c.Streetaddress</td>
                <td>@c.City</td>
            </tr>

        }
    </tbody>
</table>

<!-- Pagination -->
<div class="bank-pagination">

    @if (Model.CurrentPage != 1)
    {
        <a class="bank-btn-outline"
           asp-page="/Admin/Customers"
           asp-route-searchName="@Model.SearchName"
           asp-route-searchCity="@Model.SearchCity"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="@(Model.CurrentPage - 1)">
            ❮
        </a>
    }

    <span class="bank-page-info">
        @Model.CurrentPage
    </span>

    @if (Model.Customers.Count == 50)
    {
        <a class="bank-btn-outline"
           asp-page="/Admin/Customers"
           asp-route-searchName="@Model.SearchName"
           asp-route-searchCity="@Model.SearchCity"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="@(Model.CurrentPage + 1)">
            ❯
        </a>
    }

</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
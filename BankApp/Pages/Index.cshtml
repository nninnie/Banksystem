@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="page-breadcrumb">
    <a asp-page="/Index">
        <i class="mdi mdi-home"></i>
    </a>
    <span>›</span>
    <span>Home</span>
</div>

<div class="welcome-card">

    <span class="welcome-kicker">
        PUBLIC OVERVIEW
    </span>

    <div class="welcome-header">

        <div>
            <h1 class="welcome-title">
                Country Statistics
            </h1>

            <p class="welcome-subtitle">
                Public overview of customers, accounts and total balance grouped by country.
            </p>
        </div>

        <div class="welcome-date">
            <i class="mdi mdi-calendar-month"></i>
            <div>
                <span>Today</span>
                <strong>@Model.Today.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong>
            </div>
        </div>

    </div>

</div>

<!--- KPI-card --->
<div class="dashboard-grid">

    <div class="dashboard-card stat-card">

        <div class="stat-icon">
            <i class="mdi mdi-account-group-outline"></i>
        </div>

        <div class="stat-content">
            <div class="stat-title">Total Customers</div>

            <div class="stat-number">
                @Model.Countries.Sum(x => x.CustomerCount).ToString("N0")
            </div>

            <div class="stat-subtitle">
                Across all countries
            </div>
        </div>

    </div>

    <div class="dashboard-card stat-card">

        <div class="stat-icon">
            <i class="mdi mdi-bank-outline"></i>
        </div>

        <div class="stat-content">
            <div class="stat-title">Total Accounts</div>

            <div class="stat-number">
                @Model.Countries.Sum(x => x.AccountCount).ToString("N0")
            </div>

            <div class="stat-subtitle">
                Across all countries
            </div>
        </div>

    </div>

    <div class="dashboard-card stat-card">

        <div class="stat-icon">
            <i class="mdi mdi-cash-multiple"></i>
        </div>

        <div class="stat-content">
            <div class="stat-title">Total Balance</div>

            <div class="stat-number">
                @Model.Countries.Sum(x => x.TotalBalance).ToString("N2")
            </div>

            <div class="stat-subtitle">
                Across all countries
            </div>
        </div>

    </div>

</div>

<!-- Country table and map, side by side -->
<div class="country-overview">
    <!-- Country table - _CountryLandingPartial -->
    <partial name="_CountryLandingPartial" model="Model.Countries" />


    <!-- Country map -->
    <div class="dashboard-card map-card">
       <h3 class="card-title">
          <i class="mdi mdi-map-marker-radius icon"></i>
            Our Countries
      </h3>

      <div id="countryMap"
             data-countries="@(System.Text.Json.JsonSerializer.Serialize(Model.Countries.Select(c => new
            {
                 name = c.Country,
                 code = CountryFlags.IsoCode(c.Country),
                 customers = c.CustomerCount,
                 accounts = c.AccountCount,
                 balance = c.TotalBalance
                 })))">
        </div>

        <p class="map-hint">Click a country to see its top 10 customers.</p>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/vendors/jvectormap/jquery-jvectormap.css" />
}

@section Scripts {
    <script src="~/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
}
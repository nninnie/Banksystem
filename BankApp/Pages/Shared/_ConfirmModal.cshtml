<!-- Reusable confirm dialog: transfer, withdraw and later "Delete user?" -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bank-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmTitle">Please confirm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmMessage" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="bank-btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="bank-btn" id="confirmOk">Confirm</button>
            </div>
        </div>
    </div>
</div>
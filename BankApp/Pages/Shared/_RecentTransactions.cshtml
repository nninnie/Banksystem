@model List<BankApp.ViewModels.TransactionViewModel>
@{
    // Set by the page that shows this partial (Deposit, Withdraw, Transfer)
    var currency = ViewData["Currency"] as string ?? "";
}

<!-- Reusable card: the latest transactions on an account (Deposit, Withdraw, Transfer) -->
<div class="dashboard-card accounts-card account-transactions-card">
    <h3 class="card-title">
        <i class="mdi mdi-history icon"></i>
        Latest Transactions
    </h3>

    @if (!Model.Any())
    {
        <p class="section-subtitle">No transactions yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="mybank-table mobile-cards">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Operation</th>
                        <th class="currency">Amount</th>
                        <th class="currency">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <!-- tx-in / tx-out = green / red edge on mobile -->
                        <tr class="@(t.Amount < 0 ? "tx-out" : "tx-in")">
                            <td data-label="Date">@t.Date.ToString("yyyy-MM-dd")</td>
                            <td data-label="Type">@t.Type</td>
                            <td data-label="Operation">@(string.IsNullOrEmpty(t.Operation) ? "–" : t.Operation)</td>
                            <td class="currency @(t.Amount < 0 ? "negative" : "positive")" data-label="Amount">@($"{t.Amount:N2} {currency}")</td>
                            <td class="currency" data-label="Balance">@($"{t.Balance:N2} {currency}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>MyBank</title>

    <!-- Corona Template CSS (vendors/) -->
    <link rel="stylesheet" href="~/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/vendors/css/vendor.bundle.base.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Corona main style -->
    <link rel="stylesheet" href="~/css/style.css" />
    <!-- My css style -->
    <link rel="stylesheet" href="~/my-css/style.css" asp-append-version="true" />
    <!-- Page-specific styles (e.g. the map on the start page) -->
    @await RenderSectionAsync("Styles", required: false)

</head>

<body>
    @{
        // Calculated once and reused in the sidebar, navbar and app launcher
        var isLoggedIn = User.Identity?.IsAuthenticated == true;
        var displayName = UserDisplay.Name(User);
        var role = UserDisplay.Role(User);
        var avatar = isLoggedIn
            ? Url.Content("~/images/faces/face16.jpg")
            : Url.Content("~/images/faces-clipart/pic-1.png");
    }

    <div class="container-scroller">

        <!-- SIDEBAR -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">

            <!-- SIDEBAR LOGO -->
            <div class="sidebar-brand-wrapper d-none d-lg-flex align-items-center justify-content-center">
                <a class="sidebar-brand brand-logo" asp-page="/Index">
                    <img src="~/images/logo/mybank-logo.png" alt="logo" />
                </a>
                <a class="sidebar-brand brand-logo-mini" asp-page="/Index">
                    <img src="~/images/logo/mybank-logo-mini.png" alt="logo" />
                </a>
            </div>

            <ul class="nav">

                <!-- PROFILE -->
                <li class="nav-item profile">
                    <div class="profile-desc">
                        <div class="profile-toggle" id="sidebarProfile">
                            <div class="profile-pic">
                                <span class="avatar-wrap">
                                    <img class="img-xs rounded-circle" src="@avatar" alt="Profile image">
                                    @if (isLoggedIn)
                                    {
                                        <span class="online-dot" title="Online"></span>
                                    }
                                </span>
                                <div class="profile-name">
                                    <h5>@displayName</h5>
                                    <span>@role</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>

                <!-- NAVIGATION -->
                <li class="nav-item nav-category">
                    <span class="nav-link">Navigation</span>
                </li>

                <!-- Visible to everyone (public start page) -->
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-page="/Index">
                        <span class="menu-icon"><i class="mdi mdi-speedometer"></i></span>
                        <span class="menu-title">Home</span>
                    </a>
                </li>

                <!-- Admin only -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Admin/Dashboard">
                            <span class="menu-icon"><i class="mdi mdi-view-dashboard"></i></span>
                            <span class="menu-title">Dashboard</span>
                        </a>
                    </li>
                }

                <!-- Admin and Cashier -->
                @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Admin/Customers">
                            <span class="menu-icon"><i class="mdi mdi-account-search"></i></span>
                            <span class="menu-title">Customers</span>
                        </a>
                    </li>
                }

                <!-- Admin only -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Admin/UserAdmin">
                            <span class="menu-icon"><i class="mdi mdi-shield-account"></i></span>
                            <span class="menu-title">User Admin</span>
                        </a>
                    </li>
                }

                <!-- Admin only -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Admin/Suspicious">
                            <span class="menu-icon"><i class="mdi mdi-alert-octagon-outline"></i></span>
                            <span class="menu-title">Suspicious</span>
                        </a>
                    </li>
                }

                <!-- Log in / Log out -->
                @if (isLoggedIn)
                {
                    <li class="nav-item menu-items">
                        <form method="post" asp-page="/Logout" class="logout-form">
                            <button type="submit" class="nav-link text-start logout-btn">
                                <span class="menu-icon"><i class="mdi mdi-logout"></i></span>
                                <span class="menu-title">Log out</span>
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Login">
                            <span class="menu-icon"><i class="mdi mdi-login"></i></span>
                            <span class="menu-title">Log in</span>
                        </a>
                    </li>
                }

            </ul>

            <div class="sidebar-tagline">
                <span>TRUST • SECURITY • GROWTH</span>
            </div>

        </nav>

        <!-- PAGE BODY -->
        <div class="container-fluid page-body-wrapper">

            <!-- NAVBAR -->
            <nav class="navbar p-0 fixed-top d-flex flex-row">

                <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
                    <button class="navbar-toggler align-self-center d-none d-lg-flex" type="button" data-toggle="minimize">
                        <span class="mdi mdi-menu"></span>
                    </button>

                    <!-- Mobile logo (sidebar is hidden under 992px) -->
                    <div class="navbar-brand-wrapper d-flex d-lg-none align-items-center">
                        <a class="navbar-brand brand-logo-mini" asp-page="/Index">
                            <img src="~/images/logo/mybank-logo-mini.png" alt="MyBank" />
                        </a>
                    </div>

                    <!-- SEARCH - find a customer by customer number (Admin/Cashier) -->
                    <ul class="navbar-nav w-100">
                        <li class="nav-item w-100">
                            @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                            {
                                <form class="nav-link mt-2 mt-md-0 d-none d-md-flex search"
                                      method="get" asp-page="/Admin/NavbarSearch">
                                    <input type="number" name="Search.CustomerId" min="1"
                                           class="form-control" placeholder="Search customer number..." />
                                </form>
                            }
                        </li>
                    </ul>

                    <!-- NAVBAR ICONS -->
                    <ul class="navbar-nav navbar-nav-right">

                        @{
                            // Notifications are set with TempData by the page that did something (flash messages).
                            // TempData is read once, so each notification is shown on the next page only.
                            var notifications = new List<string>();

                            if (TempData["NewCustomer"] != null)
                                notifications.Add("New customer registered");

                            if (TempData["LargeWithdrawal"] != null)
                                notifications.Add("Large withdrawal detected");

                            if (TempData["TransferCompleted"] != null)
                                notifications.Add(TempData["TransferCompleted"]!.ToString()!);

                            var hasWarning = TempData["LargeWithdrawal"] != null;

                            var hasWelcome = TempData["Welcome"] != null;
                        }

                        <li class="nav-item nav-settings d-none d-lg-block">
                            <button type="button"
                                    id="app-launcher-btn"
                                    class="nav-link btn btn-link"
                                    aria-label="Open app menu"
                                    aria-controls="app-launcher"
                                    aria-expanded="false">
                                <i class="mdi mdi-view-grid icon-white"></i>
                            </button>
                        </li>

                        <li class="nav-item dropdown border-left">
                            <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-bs-toggle="dropdown">
                                <i class="mdi mdi-bell icon-white"></i>
                                @if (notifications.Any())
                                {
                                    <span class="count @(hasWarning ? "dot-warning" : "dot-info")"></span>
                                }
                            </a>

                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="notificationDropdown">
                                <h6 class="p-3 mb-0">Notifications</h6>
                                <div class="dropdown-divider"></div>
                                @if (notifications.Any())
                                {
                                    foreach (var note in notifications)
                                    {
                                        <a class="dropdown-item">@note</a>
                                    }
                                }
                                else
                                {
                                    <p class="dropdown-item mb-0">No new notifications</p>
                                }

                                <div class="dropdown-divider"></div>
                                <p class="p-3 mb-0 text-center">End of notifications</p>
                            </div>
                        </li>

                        <li class="nav-item dropdown border-left">
                            <a class="nav-link count-indicator dropdown-toggle" id="messageDropdown" href="#" data-bs-toggle="dropdown">
                                <i class="mdi mdi-email icon-white"></i>
                                @if (hasWelcome)
                                {
                                    <span class="count dot-info"></span>
                                }
                            </a>

                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="messageDropdown">
                                <h6 class="p-3 mb-0">Messages</h6>
                                <div class="dropdown-divider"></div>

                                @if (isLoggedIn)
                                {
                                    <a class="dropdown-item">
                                        <i class="mdi mdi-email-open text-info me-2"></i>
                                        Welcome back, @displayName!
                                    </a>

                                    <a class="dropdown-item">
                                        <i class="mdi mdi-clock-outline text-secondary me-2"></i>
                                        Logged in at: @(User.FindFirst("LoginTime")?.Value ?? "-")
                                    </a>
                                }

                                <div class="dropdown-divider"></div>
                                <p class="p-3 mb-0 text-center">End of messages</p>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link" id="profileDropdown" href="#" data-bs-toggle="dropdown">
                                <div class="navbar-profile">
                                    <span class="avatar-wrap">
                                        <img class="img-xs rounded-circle" src="@avatar" alt="Profile image">
                                        @if (isLoggedIn)
                                        {
                                            <span class="online-dot" title="Online"></span>
                                        }
                                    </span>

                                    <div class="navbar-profile-text d-none d-sm-flex">
                                        <span class="navbar-profile-name">@displayName</span>
                                        <span class="navbar-profile-role">@role</span>
                                    </div>

                                    <i class="mdi mdi-chevron-down d-none d-sm-block"></i>
                                </div>
                            </a>

                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list" aria-labelledby="profileDropdown">
                                @if (isLoggedIn)
                                {
                                    <form method="post" asp-page="/Logout">
                                        <button type="submit" class="dropdown-item preview-item">
                                            <div class="preview-thumbnail">
                                                <div class="preview-icon rounded-circle">
                                                    <i class="mdi mdi-logout text-danger"></i>
                                                </div>
                                            </div>
                                            <div class="preview-item-content">
                                                <p class="preview-subject mb-1">Log out</p>
                                            </div>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a class="dropdown-item preview-item" asp-page="/Login">
                                        <div class="preview-thumbnail">
                                            <div class="preview-icon rounded-circle">
                                                <i class="mdi mdi-login text-success"></i>
                                            </div>
                                        </div>
                                        <div class="preview-item-content">
                                            <p class="preview-subject mb-1">Log in</p>
                                        </div>
                                    </a>
                                }
                            </div>
                        </li>

                    </ul>

                    <!-- Mobile and tablet: opens the sidebar (handled by off-canvas.js) -->
                    <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center"
                            type="button" data-toggle="offcanvas" aria-label="Open menu">
                        <span class="mdi mdi-menu"></span>
                    </button>

                </div>
            </nav>

            <!-- APP-LAUNCHER -->
            <div id="app-launcher" class="app-launcher hidden">
                <div class="launcher-grid">

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/Dashboard" class="launcher-item">
                            <i class="mdi mdi-view-dashboard"></i>
                            <span>Dashboard</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a href="/Admin/Customers" class="launcher-item">
                            <i class="mdi mdi-account-group"></i>
                            <span>Customers</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/UserAdmin" class="launcher-item">
                            <i class="mdi mdi-shield-account"></i>
                            <span>User Admin</span>
                        </a>
                    }

                </div>
            </div>

            <!-- MAIN CONTENT -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </div>

        </div>
    </div>

    <!-- JS (vendors/) -->
    <script src="~/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/vendors/chart.js/Chart.min.js"></script>

    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/misc.js"></script>

    <!-- My javascript -->
    <script src="~/my-js/script.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
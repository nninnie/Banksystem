@model BankApp.ViewModels.PageHeaderViewModel

<div class="welcome-card @(Model.Compact ? "welcome-card-compact" : "")">
    <span class="welcome-kicker">@Model.Kicker</span>

    <div class="welcome-header">
        <div>
            <h1 class="welcome-title">@Model.Title</h1>
            <p class="welcome-subtitle">@Model.Subtitle</p>
        </div>

        @if (Model.ShowDate)
        {
            <div class="welcome-date">
                <i class="mdi mdi-calendar-month"></i>
                <div>
                    <span>Today</span>
                    <strong>@SwedishTime.Now.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ActionPage))
        {
            <a class="bank-btn" asp-page="@Model.ActionPage">
                <i class="mdi @Model.ActionIcon"></i>&nbsp;@Model.ActionText
            </a>
        }
    </div>
</div>
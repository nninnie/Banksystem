@page
@model IndexModel
@{
    ViewData["Title"] = "Statistik per land";
}

<h2>Statistik per land</h2>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Land</th>
            <th>Kunder</th>
            <th>Konton</th>
            <th>Totalt saldo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Countries)
        {
            <tr>
                <td>
                    <a href="/Country/@c.Country">@c.Country</a>
                </td>
                <td>@c.CustomerCount</td>
                <td>@c.AccountCount</td>
                <td>@c.TotalBalance.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h2>Country Statistics</h2>

<p class="text-muted">
    Public overview of customers, accounts, and total balance grouped by country.
    This information is available to all visitors and does not require login.
</p>


<table class="mybank-table">

    <thead>
        <tr>
            <th>Country</th>
            <th>Customers</th>
            <th>Accounts</th>
            <th>Total Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Countries)
        {
            <tr>
                <td>
                    <a href="/Country/@c.Country">@c.Country</a>
                </td>
                <td>@c.CustomerCount</td>
                <td>@c.AccountCount</td>
                <td>@c.TotalBalance.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

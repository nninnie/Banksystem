<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>MyBank</title>

    <!-- Corona Template CSS (vendors/) -->
    <link rel="stylesheet" href="~/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/vendors/jvectormap/jquery-jvectormap.css" />
    <link rel="stylesheet" href="~/vendors/flag-icon-css/css/flag-icon.min.css" />
    <link rel="stylesheet" href="~/vendors/owl-carousel-2/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/vendors/owl-carousel-2/owl.theme.default.min.css" />

    <!-- Corona main style -->
    <link rel="stylesheet" href="~/css/style.css" />
    <!-- Min css style -->
    <link rel="stylesheet" href="~/my-css/style.css" />
</head>

<body>
    <div class="container-scroller">

        <!-- SIDEBAR -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">

            <!-- SIDEBAR LOGO -->

            <div class="sidebar-brand-wrapper d-none d-lg-flex align-items-center justify-content-center">
                <a class="sidebar-brand brand-logo" asp-page="/Index">
                    <img src="~/images/logo/mybank-logo.png" alt="logo" />
                </a>
                <a class="sidebar-brand brand-logo-mini" asp-page="/Index">
                    <img src="~/images/logo/mybank-logo-mini.png" alt="logo" />
                </a>
            </div>

            <ul class="nav">

                <!-- PROFILE -->
                <li class="nav-item profile">
                    <div class="profile-desc">
                        <div class="profile-pic">
                            <div class="count-indicator">
                                <img class="img-xs rounded-circle" src="~/images/faces/face16.jpg" alt="">
                                <span class="count bg-success"></span>
                            </div>
                            <div class="profile-name">
                                @{
                                    var nameSidebar = "Guest";
                                    if (User.Identity?.Name != null)
                                    {
                                        var rawSidebar = User.Identity.Name.Split('@')[0].Replace(".", " ");
                                        nameSidebar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(rawSidebar);
                                    }
                                }
                                <h5 class="mb-0 font-weight-normal">@nameSidebar</h5>
                                <span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        @:Admin
                                    }
                                    else if (User.IsInRole("Cashier"))
                                    {
                                        @:Cashier
                                    }
                                    else
                                    {
                                        @:Visitor
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </li>

                <!-- NAVIGATION -->
                <li class="nav-item nav-category">
                    <span class="nav-link">Navigation</span>
                </li>

                <!-- Visible to everyone (public start page) -->
                <li class="nav-item menu-items">
                    <a class="nav-link" asp-page="/Index">
                        <span class="menu-icon"><i class="mdi mdi-speedometer"></i></span>
                        <span class="menu-title">Dashboard</span>
                    </a>
                </li>

                <!-- Admin and Cashier -->
                @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Customers/Index">
                            <span class="menu-icon"><i class="mdi mdi-account-search"></i></span>
                            <span class="menu-title">Customers</span>
                        </a>
                    </li>

                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Transactions/Index">
                            <span class="menu-icon"><i class="mdi mdi-swap-horizontal"></i></span>
                            <span class="menu-title">Transactions</span>
                        </a>
                    </li>
                }

                <!-- Admin only -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Admin/Index">
                            <span class="menu-icon"><i class="mdi mdi-shield-account"></i></span>
                            <span class="menu-title">User Administration</span>
                        </a>
                    </li>
                }

                <!-- Log in / Log out -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item menu-items">
                        <form method="post" asp-page="/Logout">
                            <button type="submit" class="nav-link btn btn-link text-start">
                                <span class="menu-icon"><i class="mdi mdi-logout"></i></span>
                                <span class="menu-title">Log out</span>
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item menu-items">
                        <a class="nav-link" asp-page="/Login">
                            <span class="menu-icon"><i class="mdi mdi-login"></i></span>
                            <span class="menu-title">Log in</span>
                        </a>
                    </li>
                }

            </ul>
        </nav>

        <!-- PAGE BODY -->
        <div class="container-fluid page-body-wrapper">

            <!-- NAVBAR -->
            <nav class="navbar p-0 fixed-top d-flex flex-row">

                <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
                    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                        <span class="mdi mdi-menu"></span>
                    </button>

                    <!-- SEARCH -->
                    <ul class="navbar-nav w-100">
                        <li class="nav-item w-100">
                            <form class="nav-link mt-2 mt-md-0 d-none d-lg-flex search">
                                <input type="text" class="form-control" placeholder="Search products">
                            </form>
                        </li>
                    </ul>

                    <!-- NAVBAR ICONS -->
                    <ul class="navbar-nav navbar-nav-right">

                        <li class="nav-item nav-settings d-none d-lg-block">
                            <a class="nav-link" href="#">
                                <i class="mdi mdi-view-grid icon-white"></i>
                            </a>
                        </li>

                        <li class="nav-item dropdown border-left">
                            <a class="nav-link count-indicator dropdown-toggle" id="messageDropdown" href="#" data-bs-toggle="dropdown">
                                <i class="mdi mdi-email icon-white"></i>
                                <span class="count bg-success"></span>
                            </a>
                        </li>

                        <li class="nav-item dropdown border-left">
                            <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#" data-bs-toggle="dropdown">
                                <i class="mdi mdi-bell icon-white"></i>
                                <span class="count bg-danger"></span>
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link" id="profileDropdown" href="#" data-bs-toggle="dropdown">
                                <div class="navbar-profile">
                                    <img class="img-xs rounded-circle" src="~/images/faces/face16.jpg" alt="">
                                    @{
                                        var nameNavbar = "Guest";
                                        if (User.Identity?.Name != null)
                                        {
                                            var rawNavbar = User.Identity.Name.Split('@')[0].Replace(".", " ");
                                            nameNavbar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(rawNavbar);
                                        }
                                    }
                                    <p class="mb-0 d-none d-sm-block navbar-profile-name">@nameNavbar</p>
                                    <i class="mdi mdi-menu-down d-none d-sm-block"></i>
                                </div>
                            </a>

                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list" aria-labelledby="profileDropdown">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form method="post" asp-page="/Logout">
                                        <button type="submit" class="dropdown-item preview-item">
                                            <div class="preview-thumbnail">
                                                <div class="preview-icon bg-dark rounded-circle">
                                                    <i class="mdi mdi-logout text-danger"></i>
                                                </div>
                                            </div>
                                            <div class="preview-item-content">
                                                <p class="preview-subject mb-1">Logga ut</p>
                                            </div>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a class="dropdown-item preview-item" asp-page="/Login">
                                        <div class="preview-thumbnail">
                                            <div class="preview-icon bg-dark rounded-circle">
                                                <i class="mdi mdi-login text-success"></i>
                                            </div>
                                        </div>
                                        <div class="preview-item-content">
                                            <p class="preview-subject mb-1">Logga in</p>
                                        </div>
                                    </a>
                                }
                            </div>
                        </li>

                    </ul>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </div>

        </div>
    </div>

    <!-- JS (vendors/) -->
    <script src="~/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/vendors/chart.js/Chart.min.js"></script>
    <script src="~/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="~/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="~/vendors/owl-carousel-2/owl.carousel.min.js"></script>

    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/misc.js"></script>
    <script src="~/js/settings.js"></script>
    <script src="~/js/todolist.js"></script>
</body>
</html>
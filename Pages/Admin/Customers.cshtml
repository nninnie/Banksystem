@page
@model BankApp.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

<h2 class="mb-4">Customers</h2>

<!-- Search form -->
<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="searchName" value="@Request.Query["searchName"]"
                   class="form-control"
                   placeholder="Search by name" />
        </div>

        <div class="col-md-4">
            <input type="text" name="searchCity" value="@Request.Query["searchCity"]"
                   class="form-control"
                   placeholder="Search by city" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">
                Search
            </button>
        </div>
    </div>
</form>

<!-- Customer list -->
<table class="mybank-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>City</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model.Customers)
        {
            <tr>
                <td>@c.CustomerId</td>

                <td>
                    <a asp-page="/Admin/Customer" asp-route-id="@c.CustomerId">
                        @c.FullName
                    </a>
                </td>

                <td>@c.City</td>
            </tr>
        }
    </tbody>
</table>

@page
@model BankApp.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

@functions {
    private string ActiveColumn =>
        string.IsNullOrEmpty(Model.SortColumn) ? "Id" : Model.SortColumn;

    // Klick på aktiv kolumn (stigande) -> fallande, annars stigande
    private string NextOrder(string column) =>
        ActiveColumn == column && Model.SortOrder != "desc" ? "desc" : "asc";

    private string Arrow(string column) =>
        ActiveColumn != column ? "" : (Model.SortOrder == "desc" ? "▼" : "▲");
}

<h2 class="mb-4">Customers</h2>

<!-- Search form -->
<form method="get" class="bank-search mb-4">
    <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
    <input type="hidden" name="sortOrder" value="@Model.SortOrder" />

    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="searchName" value="@Model.SearchName"
                   class="form-control" placeholder="Search by name" />
        </div>

        <div class="col-md-4">
            <input type="text" name="searchCity" value="@Model.SearchCity"
                   class="form-control" placeholder="Search by city" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="bank-btn w-100">Search</button>
        </div>
    </div>
</form>

<!-- Customer list -->
<table class="mybank-table">
    <thead>
        <tr>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Id"
                   asp-route-sortOrder="@NextOrder("Id")">ID @Arrow("Id")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="NationalId"
                   asp-route-sortOrder="@NextOrder("NationalId")">National ID @Arrow("NationalId")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Name"
                   asp-route-sortOrder="@NextOrder("Name")">Name @Arrow("Name")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="Address"
                   asp-route-sortOrder="@NextOrder("Address")">Address @Arrow("Address")</a>
            </th>
            <th>
                <a asp-page="/Admin/Customers"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchCity="@Model.SearchCity"
                   asp-route-sortColumn="City"
                   asp-route-sortOrder="@NextOrder("City")">City @Arrow("City")</a>
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model.Customers)
        {
            <tr class="clickable-row">
                <td>
                    <a asp-page="/Admin/Customer" asp-route-id="@c.CustomerId" class="stretched-link">
                        @c.CustomerId
                    </a>
                </td>
                <td>@c.NationalId</td>
                <td>@c.FullName</td>
                <td>@c.Streetaddress</td>
                <td>@c.City</td>
            </tr>

        }
    </tbody>
</table>

<!-- Pagination -->
<div class="bank-pagination mt-4">
    @if (Model.CurrentPage != 1)
    {
        <a class="bank-btn-outline" asp-page="/Admin/Customers"
           asp-route-searchName="@Model.SearchName"
           asp-route-searchCity="@Model.SearchCity"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="@(Model.CurrentPage - 1)">Previous</a>
    }

    <span class="bank-page-info">Page @Model.CurrentPage</span>

    @if (Model.Customers.Count == 50)
    {
        <a class="bank-btn-outline" asp-page="/Admin/Customers"
           asp-route-searchName="@Model.SearchName"
           asp-route-searchCity="@Model.SearchCity"
           asp-route-sortColumn="@Model.SortColumn"
           asp-route-sortOrder="@Model.SortOrder"
           asp-route-pageNo="@(Model.CurrentPage + 1)">Next</a>
    }
</div>
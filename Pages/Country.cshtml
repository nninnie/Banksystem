@page
@model BankApp.Pages.CountryModel
@{
    ViewData["Title"] = "Top 10 - " + Model.Country;
}

<h2>Top 10 customers in @Model.Country</h2>

<p class="text-muted">
    The ten customers with the highest total balance in this country.
</p>

@if (!Model.TopCustomers.Any())
{
    <p>No customers found for the selected country.</p>
}
else
{
    <table class="mybank-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Customer ID</th>
                <th>Name</th>
                <th>City</th>
                <th>Total Balance</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rank = 1;
            }
            @foreach (var c in Model.TopCustomers)
            {
                <tr>
                    <td>@(rank++)</td>
                    <td><a asp-page="/Customer" asp-route-id="@c.CustomerId">@c.CustomerId</a></td>
                    <td>@c.FullName</td>
                    <td>@c.City</td>
                    <td>@c.TotalBalance.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="bank-btn-outline" onclick="history.back()">
    <i class="mdi mdi-arrow-left me-1"></i> Back
</button>

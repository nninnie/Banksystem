@page
@model BankApp.Pages.CountryModel
@{
    ViewData["Title"] = "Top 10 - " + Model.Country;
}

<div class="page-breadcrumb">
    <i class="mdi mdi-home"></i>
    <a asp-page="/Index">Home</a>
    <span>></span>
    <a asp-page="/Country" asp-route-country="@Model.Country">
        @Model.Country
    </a>
    <span>></span>
    <span>Top 10 Customers</span>
</div>

<h2>Top 10 customers in @Model.Country</h2>

<p class="text-muted">
    The ten customers with the highest total balance in this country.
</p>

@if (!Model.TopCustomers.Any())
{
    <p>No customers found for the selected country.</p>
}
else
{
    <table class="mybank-table">
        <thead>
            <tr>
                <th>Customer ID</th>
                <th>Name</th>
                <th>City</th>
                <th class="currency">Total Balance</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rank = 1;
            }
            @foreach (var c in Model.TopCustomers)
            {
                <tr class="clickable-row">
                    <td class="customer-id">
                        <a asp-page="/Admin/Customer" asp-route-id="@c.CustomerId" class="stretched-link">
                            @c.CustomerId
                        </a>
                    </td>
                    <td class="primary-value">@c.FullName</td>
                    <td>@c.City</td>
                    <td class="currency">@c.TotalBalance.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="bank-btn-outline mt-3" onclick="history.back()">
    <i class="mdi mdi-chevron-left"></i>
</button>
